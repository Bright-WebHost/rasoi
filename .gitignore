# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local testing scripts, dumps, and credentials
scratch/
*.py
__pycache__/
test-*.js
test_*.js
*.log

# ignore workflow dumps and debug json files
debug_*.json
production_*.json
status_*.json
n8n/
n8n_backups/
referenece/

# Local DB scripts (contain credentials)
update_chat_context.js
scratch_update.js

# Scratch scripts and dumps often contain keys — never commit them
scratch/
__pycache__/
*.pyc
